{
  "$schema":"https://developers.cloudflare.com/workers/wrangler/configuration/schema.json",
  "name":"commerce-league",
  "main":"src/index.js",
  "compatibility_date":"2026-10-17",
  "workers_dev":true,
  "assets":{"directory":"../","binding":"ASSETS","run_worker_first":["/api/*"]},
  "d1_databases":[{"binding":"DB","database_name":"commerce-league-students","database_id":"REPLACE_AFTER_CREATING_D1"}]
}
